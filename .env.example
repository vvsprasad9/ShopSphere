# ===================================================================
# ShopSphere - Root Environment Variable Configuration Template
# ===================================================================
# INSTRUCTIONS:
#   1. Copy this file to '.env' in the project root:
#        cp .env.example .env
#   2. Replace all placeholder values with secure, environment-specific secrets.
#   3. NEVER commit the generated '.env' file to Git or version control!
#
# NOTE ON VARIABLE TIERS:
#   - Compose Interpolation: Read by Docker Compose when creating services and networks.
#   - Runtime Environment: Passed into containers as runtime environment variables.
#   - Build Arguments: Baked into client bundles at image build time (Vite).
# ===================================================================

# -------------------------------------------------------------------
# SECTION 1: DOCKER COMPOSE INTERPOLATION
# -------------------------------------------------------------------
# Project name prefix for container and volume naming
COMPOSE_PROJECT_NAME=shopsphere

# Host port mapped to Nginx reverse proxy (Port 80 serves both SPA and /api proxy)
FRONTEND_PORT=80

# Production GHCR Image Deployment Interpolation (for docker-compose.prod.yml)
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=shopsphere
IMAGE_TAG=latest

# -------------------------------------------------------------------
# SECTION 2: MYSQL DATABASE CONFIGURATION (Runtime & Compose)
# -------------------------------------------------------------------
# MySQL root password (used exclusively for container initialization & health checks)
MYSQL_ROOT_PASSWORD=ShopSphereRootPass2026!Secure

# Dedicated application database and non-root user credentials
DB_NAME=shopsphere_db
DB_USERNAME=shopsphere_user
DB_PASSWORD=ShopSphereAppPass2026!Secure

# HikariCP Connection Pool Sizing (Tuned for production throughput)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=10

# -------------------------------------------------------------------
# SECTION 3: BACKEND SECURITY & JWT (Container Runtime)
# -------------------------------------------------------------------
# Secret key for HS256 HMAC JWT signing (Minimum 256 bits / 64 hex characters or 48+ base64)
# Generate a cryptographically secure key: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiration Lifetimes
JWT_EXPIRATION_MS=86400000          # 24 hours (Access Token)
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days (Refresh Token Rotation)

# -------------------------------------------------------------------
# SECTION 4: INITIAL SUPER-ADMIN CREDENTIALS (DataInitializer Runtime)
# -------------------------------------------------------------------
# Provisioned on first database startup if admin user does not exist
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@shopsphere.com
ADMIN_PASSWORD=AdminSecureP@ssw0rd2026!

# -------------------------------------------------------------------
# SECTION 5: PAYMENT GATEWAY (RAZORPAY - Container Runtime)
# -------------------------------------------------------------------
# Live or sandbox Razorpay API credentials.
# In production profile (SPRING_PROFILES_ACTIVE=prod), placeholders are strictly rejected.
RAZORPAY_KEY_ID=rzp_live_yourActualKeyIdHere
RAZORPAY_KEY_SECRET=yourActualKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourActualWebhookSecretHere

# -------------------------------------------------------------------
# SECTION 6: BACKEND RUNTIME OPTIMIZATIONS (Container Runtime)
# -------------------------------------------------------------------
# Local media uploads directory inside container (mounted to uploads_data volume)
APP_UPLOAD_DIR=/app/uploads

# Toggle OpenAPI / Swagger documentation endpoints (Disabled by default in production)
SWAGGER_ENABLED=false

# JVM Container Memory & Entropy Configuration
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -Djava.security.egd=file:/dev/./urandom

# -------------------------------------------------------------------
# SECTION 7: FRONTEND CLIENT CONFIGURATION (Build-Time Vite Arguments)
# -------------------------------------------------------------------
# Base URL for API requests. In production Docker stack, Nginx proxies /api/
# to the Spring Boot backend on http://backend:8080/api/.
VITE_API_BASE_URL=/api/v1
